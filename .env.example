# Examples only: export/set these in your shell; this file is NOT auto-loaded.
# Shrinkcage needs no API keys or authentication files.
OPEN_BROWSER=0
# SHRINKCAGE_DATA_DIR=/absolute/local/shrinkcage-data
# CODEX_HOME=/absolute/local/codex-home
# CLAUDE_CONFIG_DIR=/absolute/local/claude-home
# SERENA_PORT_START=24282
# SERENA_PORT_COUNT=10
# MONITOR_SNAPSHOTS=1
# RTK_DATABASE_PATH=/absolute/local/rtk/history.db
# Managed Headroom only: fixed 127.0.0.1 port, 1024..65535 except 8790.
# Existing overview monitor continues to read its documented 8787 endpoint.
# SHRINKCAGE_HEADROOM_PORT=8787
# Test-only: optional local Chromium-compatible executable for browser QA.
# SHRINKCAGE_BROWSER_EXECUTABLE=/absolute/local/browser-executable
