{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shrinkcage optimizer candidate v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "entry": {
      "allOf": [
        {
          "$ref": "catalog.schema.json#/$defs/entry"
        },
        {
          "properties": {
            "trust": {
              "properties": {
                "state": {
                  "enum": [
                    "candidate",
                    "under_review",
                    "rejected"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "discoveredAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastCheckedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[^\\x00-\\x1f<>]+$"
      },
      "maxItems": 100
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "context-compression",
            "output-optimization",
            "semantic-retrieval",
            "mcp-discovery",
            "prompt-caching",
            "persistent-memory",
            "model-routing",
            "usage-analytics",
            "observability",
            "other-verified"
          ]
        },
        "confidence": {
          "enum": [
            "documented",
            "heuristic",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\x00-\\x1f<>]+$"
          },
          "maxItems": 100
        }
      },
      "required": [
        "category",
        "confidence",
        "reasons"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[^\\x00-\\x1f<>]+$"
      },
      "maxItems": 100
    },
    "previousVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\x00-\\x1f<>]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapterProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "enum": [
            "mcp-stdio",
            "review-required"
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "../sdk/optimizer.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\x00-\\x1f<>]+$"
          },
          "maxItems": 100
        }
      },
      "required": [
        "template",
        "manifest",
        "diagnostics"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "entry",
    "discoveredAt",
    "lastCheckedAt",
    "sources",
    "classification",
    "diagnostics",
    "previousVersion"
  ]
}
