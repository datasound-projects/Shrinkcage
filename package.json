{
  "name": "shrinkcage-monitor",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "check": "tsc --noEmit",
    "launch": "node scripts/start.mjs",
    "package": "npm run build && node scripts/licenses.mjs && node scripts/package.mjs",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "coverage": "c8 node --import tsx --test tests/control-planner.test.ts tests/control-transactions.test.ts",
    "test:ui": "node scripts/ui-test.mjs && node --import tsx scripts/control-ui-test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "c8": "12.0.0",
    "playwright": "1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "description": "Local-first token and cost optimization for AI coding sessions.",
  "license": "MIT",
  "bin": {
    "shrinkcage": "bin/shrinkcage.mjs"
  },
  "files": [
    "dist/",
    "dist-server/server/",
    "bin/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/CONNECTORS.md",
    "docs/PRIVACY.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/VALIDATION.md",
    "public/icon.svg",
    "docs/images/overview.png",
    "docs/images/sessions.png",
    "docs/BASELINE.md",
    "docs/CONTROL_PLANE.md",
    "docs/TEST_MATRIX.md",
    "docs/images/control-plane.png",
    "docs/images/managed.png",
    "docs/SETUP.md",
    "docs/ACCOUNTING.md",
    "docs/OPTIMIZERS.md",
    "sdk/",
    "docs/PLUGINS.md",
    "docs/COMPATIBILITY.md",
    "docs/images/quick-setup.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datasound-projects/Shrinkcage.git"
  },
  "homepage": "https://github.com/datasound-projects/Shrinkcage#readme",
  "bugs": {
    "url": "https://github.com/datasound-projects/Shrinkcage/issues"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "exports": {
    "./sdk": {
      "types": "./dist-server/server/control/sdk/contract.d.ts",
      "import": "./dist-server/server/control/sdk/contract.js"
    },
    "./sdk/schema": "./sdk/optimizer.schema.json"
  }
}
